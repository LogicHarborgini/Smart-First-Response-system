# Copy to .env and fill in your own values:  cp .env.example .env
# The real .env is gitignored — never commit it.

# AWS
# Credentials are NOT read from here. boto3 resolves them from the standard
# credential chain: `aws configure` locally, IAM role on Lambda/ECS.
AWS_DEFAULT_REGION=us-east-1

# Provider: auto | bedrock | ollama | fake
#   auto     bedrock if boto3 can resolve credentials, else ollama
#   fake     canned responses — exercises tracing/evals with no model at all.
#            Must be set explicitly; auto never selects it.
LLM_PROVIDER=auto

# Model
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_MAX_TOKENS=512
BEDROCK_TEMPERATURE=0.3
OLLAMA_MODEL=llama3.2

# Eval judge (evals/sfr_eval.py). Follows LLM_PROVIDER; these pick the model
# within it. Judge defaults are cheaper/smaller than the chain's on purpose —
# it runs once per criterion per example.
JUDGE_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
JUDGE_OLLAMA_MODEL=llama3.2

# API
APP_TITLE=Smart First Response API
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# LangSmith observability
# Create a key at https://smith.langchain.com/settings -> API Keys
# Set LANGSMITH_TRACING=false to turn tracing off without removing the key.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_your_key_here
LANGSMITH_PROJECT=sfr-support-assistant

# Groq — free hosted LLM, used for the public Railway deployment
GROQ_API_KEY=gsk_your_actual_key_here
GROQ_MODEL=llama-3.1-8b-instant
